{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "outputDirectory": "web_static",
  "regions": ["bom1"],
  "functions": {
    "api/index.mjs": {
      "memory": 1024,
      "maxDuration": 30,
      "includeFiles": "web_static/{js/**,ort/**,model/**,css/**,kb.json}"
    }
  },
  "rewrites": [{ "source": "/api/(.*)", "destination": "/api" }]
}
